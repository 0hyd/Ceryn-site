			"width":250,
			"height":120
		},
		{
			"id":"60f72659e6e82d05",
			"styleAttributes":{},
			"text":"叶绿素",
			"type":"text",
			"x":-452,
			"y":837,
			"width":112,
			"height":29
		},
		{
			"id":"63c7805a00f1cc90",
			"styleAttributes":{},
			"text":"T.W.恩格尔曼（Theodor W. Engelmann，1880年代）  \n德国科学家恩格尔曼通过实验揭示了叶绿素在光合作用中的作用。他使用含氧细菌和藻类进行实验，发现细菌聚集在光谱中红光和蓝光区域（叶绿素吸收最强的波长），证明叶绿素是捕获光能的关键物质。",
			"type":"text",
			"x":-1083,
			"y":-395,
			"width":333,
			"height":255
		},
		{
			"id":"822729c9e6a1ad4f",
			"styleAttributes":{},
			"text":"### 色素",
