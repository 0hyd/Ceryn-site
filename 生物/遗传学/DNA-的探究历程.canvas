		{"id":"b25016e554bfad6d","type":"text","text":"1944 年","x":-1112,"y":490,"width":250,"height":60},
		{"id":"bed04504c8c6597c","type":"file","file":"生物/遗传学/files/Oswald-Avery.jpg","x":-203,"y":407,"width":160,"height":225},
		{"id":"67eb02258f81000f","type":"text","text":"## 沃森和克里克","x":-718,"y":1320,"width":250,"height":60},
